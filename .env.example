# Copy to .env and fill in. deploy.sh and pm2 read this file.

# Port the server listens on. Point your tunnel at http://localhost:<PORT>.
PORT=8010

# SQLite database (relative paths are from the project root). Back this file up.
DATABASE_PATH=backend/pleasestudy.db

# Pictures saved from Blooket PDF imports. Back this folder up along with the database.
IMAGES_DIR=backend/images

# Optional: enables the GIF picker. Get a key at https://partner.klipy.com/
KLIPY_API_KEY=

# Log level
RUST_LOG=pleasestudy=info
